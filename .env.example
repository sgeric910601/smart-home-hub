HUB_MODE=mock
HUB_ADMIN_PASSWORD=
HUB_SESSION_SECRET=
HUB_VIEWER_PASSWORD=
HUB_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:8080","http://localhost:8080"]
HUB_DATABASE_URL=sqlite:///./data/hub.db
HUB_SECURE_COOKIE=false
# 私人網址的完整 HTTPS Origin（例如 https://homehub.example.com）；設定後自動允許此來源並只發安全 Cookie。
HUB_PUBLIC_ORIGIN=
# 登入有效時數（1–720），私人部署建議 168。
HUB_SESSION_HOURS=8
# Tailscale 身分登入：白名單帳號免密碼，需在主機執行 tailscaled 並可讀取其 socket。
HUB_TAILSCALE_AUTH=false
HUB_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
HUB_TAILSCALE_ADMINS=[]
HUB_TAILSCALE_VIEWERS=[]
HA_URL=
# 配對頁面使用的 HA 網址；留空沿用 HA_URL。手機需填可達的 LAN／VPN 網址，不填 Token。
HA_BROWSER_URL=
HA_TOKEN=
# 可留空並使用網頁「新增裝置」；專屬攝影機／除濕機等進階映射仍可指定私有 JSON。
HUB_MAPPING_FILE=

# 私人發布時由 FastAPI 提供已建置前端，預設關閉
HUB_SERVE_FRONTEND=false
# 可選：後端私有 JSON 的絕對路徑，含 model、address、ltmk。空白時不啟用藍牙。
HUB_BLE_DIFFUSER_CONFIG=
