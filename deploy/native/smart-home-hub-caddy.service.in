[Unit]
Description=Smart Home Hub HTTPS 入口（只監聽 Tailscale 位址）
After=network-online.target tailscaled.service smart-home-hub.service
Wants=network-online.target

[Service]
Type=notify
User=@USER@
EnvironmentFile=@ROOT@/deploy/caddy.env
Environment=HUB_STATIC_ROOT=@ROOT@/frontend/dist
Environment=XDG_DATA_HOME=/var/lib/smart-home-hub-caddy
Environment=XDG_CONFIG_HOME=/var/lib/smart-home-hub-caddy
StateDirectory=smart-home-hub-caddy
ExecStart=/usr/local/bin/caddy-homehub run --config @ROOT@/deploy/caddy/Caddyfile --adapter caddyfile
# 開機時 Tailscale 可能尚未取得位址，綁定失敗會自動重試。
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
