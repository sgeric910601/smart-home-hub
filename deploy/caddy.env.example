# 由 deploy/setup-pi.sh 產生 deploy/caddy.env；此檔含 Cloudflare Token，權限需為 600 且不可提交。
HUB_DOMAIN=homehub.example.com
# 樹莓派的 Tailscale IPv4 與 IPv6（tailscale ip -4／-6），以空白分隔。
HUB_BIND=100.64.0.1 fd7a:115c:a1e0::1
ACME_EMAIL=you@example.com
# Cloudflare API Token：只授權該網域的 Zone:Read 與 DNS:Edit。
CLOUDFLARE_API_TOKEN=
